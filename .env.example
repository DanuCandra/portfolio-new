# ==============================================================================
# DANUCS.COM — Environment Configuration Template
# ==============================================================================
# Salin file ini menjadi .env.local untuk pengembangan lokal, atau atur di
# Environment Variables Node Project Manager pada VPS aaPanel saat production.

# URL Domain utama (ganti ke https://danucs.com ketika domain sudah aktif)
NEXT_PUBLIC_SITE_URL=https://danucs.com
NEXT_PUBLIC_SITE_NAME="Danu Candra Saputra"
NEXT_PUBLIC_BRAND_HANDLE="danucs"

# Aktifkan "true" hanya jika deploy menggunakan Docker / standalone server.js
NEXT_OUTPUT_STANDALONE=false

